# Copy to .env; never commit real credentials. Go itself reads exported variables.
BURROW_ENV=dev
BURROW_LISTEN_ADDR=:8080
BURROW_ISSUER=http://localhost:8080
# Native local development defaults to SQLite. Compose always uses PostgreSQL.
BURROW_DB_DRIVER=sqlite
BURROW_DB_DSN=burrow.db
# Generate with: openssl rand -base64 32
BURROW_MASTER_KEY=
BURROW_SESSION_TTL=8h
BURROW_TOKEN_TTL=5m
BURROW_AUTH_CODE_TTL=60s
BURROW_LOGIN_TTL=10m
BURROW_EVENT_RETENTION=2160h
# Comma-separated CIDRs. Empty = no trusted reverse proxies / private Providers.
BURROW_TRUSTED_PROXIES=
BURROW_PROVIDER_ALLOWED_CIDRS=

BURROW_IMAGE=burrow:local
BURROW_BIND_ADDR=127.0.0.1
BURROW_PORT=8080
POSTGRES_DB=burrow
POSTGRES_USER=burrow
# Generate a random password; for Compose replace BURROW_DB_DSN above with:
# host=postgres user=burrow password=YOUR_PASSWORD dbname=burrow port=5432 sslmode=disable
# For an external database use its host and TLS settings instead.
POSTGRES_PASSWORD=
