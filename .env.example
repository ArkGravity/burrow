# Docker Compose only. Native commands read configs/config.yaml instead.
# Copy this file to .env. The default master key is a public development example.
# Replace it for production. Generate two independent deployment secrets:
#   openssl rand -base64 32  -> BURROW_MASTER_KEY
#   openssl rand -hex 24    -> POSTGRES_PASSWORD and the password in BURROW_DB_DSN
BURROW_ENV=dev
BURROW_ISSUER=http://localhost:8080
BURROW_MASTER_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
BURROW_DB_DSN="host=postgres port=5432 user=burrow password=CHANGE_ME dbname=burrow sslmode=disable"

# Bootstrap settings are used only for first administrator creation.
# Existing credentials are preserved by seed. Replace the example in production.
BURROW_BOOTSTRAP_ADMIN_USERNAME=admin
BURROW_BOOTSTRAP_ADMIN_NAME=Administrator
BURROW_BOOTSTRAP_ADMIN_EMAIL=
BURROW_BOOTSTRAP_ADMIN_PASSWORD=Burrow-development-admin-2026

BURROW_IMAGE=burrow:local
BURROW_BIND_ADDR=127.0.0.1
BURROW_PORT=8080
POSTGRES_DB=burrow
POSTGRES_USER=burrow
POSTGRES_PASSWORD=

# Optional application overrides. Empty CIDRs trust no proxies/private Providers.
BURROW_SESSION_TTL=8h
BURROW_TOKEN_TTL=5m
BURROW_AUTH_CODE_TTL=60s
BURROW_LOGIN_TTL=10m
BURROW_EVENT_RETENTION=2160h
BURROW_TRUSTED_PROXIES=
BURROW_PROVIDER_ALLOWED_CIDRS=

# Production: set BURROW_ENV=prod and an HTTPS issuer. For an external PostgreSQL
# database, set its host/credentials/TLS settings in BURROW_DB_DSN and omit the
# local-db profile. Keep the master key stable for the lifetime of the database.
